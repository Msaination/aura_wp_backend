          "elements": [
            {
              "id": "aura00203",
              "settings": {
                "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Italiana&display=swap');\n\n      :root {\n        --ink: #302a27;\n        --ink-soft: #685f5a;\n        --greige: #cdc6c3;\n        --rose: #cfb3a9;\n        --rose-deep: #9a7770;\n        --dusty: #a09086;\n        --cream: #e4d8cb;\n        --paper: #fffcf8;\n        --sage: #657267;\n        --mist: #d9d5cf;\n        --line: rgba(48, 42, 39, 0.16);\n        --serif: 'Italiana', Georgia, serif;\n        --sans: 'DM Sans', sans-serif;\n        --ease: cubic-bezier(0.22, 1, 0.36, 1);\n      }\n\n      * { box-sizing: border-box; }\n      html { scroll-behavior: smooth; }\n      body {\n        min-width: 320px;\n        margin: 0;\n        color: var(--ink);\n        background: var(--paper);\n        font-family: var(--sans);\n        -webkit-font-smoothing: antialiased;\n      }\n      body.menu-open { overflow: hidden; }\n      a { color: inherit; }\n      button, a { -webkit-tap-highlight-color: transparent; }\n      button { font: inherit; }\n      img { display: block; max-width: 100%; }\n\n      .skip-link {\n        position: fixed;\n        z-index: 100;\n        top: 0.75rem;\n        left: 0.75rem;\n        padding: 0.7rem 1rem;\n        color: var(--paper);\n        background: var(--ink);\n        transform: translateY(-150%);\n      }\n      .skip-link:focus { transform: translateY(0); }\n\n      .hero {\n        position: relative;\n        display: grid;\n        min-height: min(92svh, 58rem);\n        isolation: isolate;\n        overflow: hidden;\n        color: var(--paper);\n        background: #6f625c url('images/AuraBG.jpg') center 47% / cover no-repeat;\n      }\n      .hero::before {\n        position: absolute;\n        z-index: -1;\n        inset: 0;\n        content: '';\n        background:\n          linear-gradient(90deg, rgba(35, 29, 27, 0.76) 0%, rgba(35, 29, 27, 0.35) 52%, rgba(35, 29, 27, 0.08) 100%),\n          linear-gradient(180deg, rgba(24, 19, 17, 0.28), transparent 36%, rgba(24, 19, 17, 0.42));\n      }\n\n      .site-header {\n        align-self: start;\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        width: min(100% - 2rem, 76rem);\n        margin: 0 auto;\n        padding: 0.9rem 0;\n        border-bottom: 1px solid rgba(255, 252, 248, 0.34);\n      }\n      .brand {\n        display: block;\n        width: clamp(7rem, 12vw, 9rem);\n        text-decoration: none;\n      }\n      .brand img {\n        display: block;\n        width: 100%;\n        height: auto;\n        filter: brightness(0) invert(1);\n      }\n      .nav-toggle {\n        position: relative;\n        z-index: 30;\n        display: grid;\n        width: 2.8rem;\n        height: 2.8rem;\n        padding: 0;\n        place-content: center;\n        gap: 0.3rem;\n        color: var(--paper);\n        cursor: pointer;\n        background: transparent;\n        border: 1px solid rgba(255, 252, 248, 0.5);\n      }\n      .nav-toggle span {\n        width: 1.15rem;\n        height: 1px;\n        background: currentColor;\n        transition: transform 0.25s ease;\n      }\n      .nav-toggle[aria-expanded='true'] { color: var(--ink); }\n      .nav-toggle[aria-expanded='true'] span:first-child { transform: translateY(0.2rem) rotate(45deg); }\n      .nav-toggle[aria-expanded='true'] span:last-child { transform: translateY(-0.2rem) rotate(-45deg); }\n      .site-nav {\n        position: fixed;\n        z-index: 20;\n        inset: 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        gap: 1.4rem;\n        color: var(--ink);\n        background: rgba(247, 242, 236, 0.98);\n        opacity: 0;\n        pointer-events: none;\n        transition: opacity 0.25s ease;\n      }\n      .site-nav.is-open { opacity: 1; pointer-events: auto; }\n      .site-nav a {\n        font-family: var(--serif);\n        font-size: clamp(2rem, 9vw, 3.4rem);\n        text-decoration: none;\n      }\n\n      .hero-inner {\n        align-self: end;\n        width: min(100% - 2rem, 76rem);\n        margin: 0 auto;\n        padding: clamp(5rem, 12vh, 8rem) 0 clamp(3.5rem, 8vh, 5.5rem);\n      }\n      .kicker {\n        display: flex;\n        align-items: center;\n        gap: 0.7rem;\n        margin: 0 0 1.1rem;\n        font-size: 0.68rem;\n        font-weight: 600;\n        letter-spacing: 0.22em;\n        text-transform: uppercase;\n      }\n      .kicker::before {\n        width: 2.6rem;\n        height: 1px;\n        content: '';\n        background: currentColor;\n      }\n      h1, h2, h3, p { margin-top: 0; }\n      h1 {\n        max-width: 7ch;\n        margin-bottom: 1.25rem;\n        font-family: var(--serif);\n        font-size: clamp(4.5rem, 15vw, 10rem);\n        font-weight: 400;\n        letter-spacing: 0;\n        line-height: 0.82;\n      }\n      .hero-copy {\n        max-width: 38rem;\n        margin-bottom: 2rem;\n        font-size: clamp(1rem, 2vw, 1.22rem);\n        line-height: 1.7;\n        text-wrap: pretty;\n      }\n      .button-row { display: flex; flex-wrap: wrap; gap: 0.65rem; }\n      .button {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        min-height: 3.25rem;\n        padding: 0.8rem 1.2rem;\n        font-size: 0.72rem;\n        font-weight: 600;\n        letter-spacing: 0.12em;\n        text-decoration: none;\n        text-transform: uppercase;\n        border: 1px solid transparent;\n        transition: color 0.3s ease, background 0.3s ease, transform 0.3s var(--ease);\n      }\n      .button:hover { transform: translateY(-2px); }\n      .button-primary { color: var(--ink); background: var(--paper); }\n      .button-secondary { color: var(--paper); border-color: rgba(255, 252, 248, 0.58); }\n\n      .hero-actions {\n        display: grid;\n        gap: 0.65rem;\n        max-width: 47rem;\n      }\n      .hero-actions .button-primary {\n        min-height: 3.8rem;\n        padding-inline: 1.6rem;\n      }\n      .hero-action-links {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 0.65rem;\n      }\n      .location-line {\n        display: flex;\n        align-items: center;\n        gap: 0.65rem;\n        margin: 0 0 1.4rem;\n        color: rgba(255, 252, 248, 0.78);\n        font-size: 0.72rem;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      .location-line::before {\n        width: 0.45rem;\n        height: 0.45rem;\n        content: '';\n        border: 1px solid currentColor;\n        transform: rotate(45deg);\n      }\n\n      main { overflow: hidden; }\n      .section { padding: clamp(4.5rem, 9vw, 8.5rem) 0; }\n      #welcome { padding-top: 2rem; }\n      .wrap { width: min(100% - 2rem, 76rem); margin: 0 auto; }\n      .section-label {\n        margin-bottom: 1.3rem;\n        color: var(--rose-deep);\n        font-size: 0.68rem;\n        font-weight: 600;\n        letter-spacing: 0.2em;\n        text-transform: uppercase;\n      }\n      .display-heading {\n        max-width: 12ch;\n        margin-bottom: 2rem;\n        font-family: var(--serif);\n        font-size: clamp(2.8rem, 7vw, 5.8rem);\n        font-weight: 400;\n        letter-spacing: 0;\n        line-height: 0.98;\n        text-wrap: balance;\n      }\n\n      .welcome-layout { display: grid; gap: 2.5rem; }\n      .welcome-copy {\n        max-width: 43rem;\n        color: var(--ink-soft);\n        font-size: clamp(1rem, 1.4vw, 1.12rem);\n        line-height: 1.85;\n      }\n      .welcome-copy p:last-child { margin-bottom: 0; }\n      .welcome-aside {\n        align-self: end;\n        padding: 1.7rem 0 0 1.5rem;\n        border-top: 1px solid var(--line);\n        border-left: 1px solid var(--line);\n      }\n      .welcome-aside strong {\n        display: block;\n        margin-bottom: 0.55rem;\n        font-family: var(--serif);\n        font-size: 2.2rem;\n        font-weight: 400;\n      }\n      .welcome-aside span {\n        color: var(--ink-soft);\n        font-size: 0.78rem;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n\n      .experience { color: var(--cream); background: var(--ink); }\n      .experience .section-label { color: var(--rose); }\n      .experience-copy { max-width: 52rem; }\n      .experience-copy h3 {\n        margin-bottom: 1.5rem;\n        font-family: var(--serif);\n        font-size: clamp(2.2rem, 5vw, 4rem);\n        font-weight: 400;\n        line-height: 1;\n      }\n      .experience-copy p {\n        color: rgba(247, 242, 236, 0.74);\n        font-size: 1rem;\n        line-height: 1.8;\n      }\n      .ritual-note {\n        display: grid;\n        grid-template-columns: auto 1fr;\n        gap: 1rem;\n        margin-top: 2rem;\n        padding-top: 1.3rem;\n        border-top: 1px solid rgba(247, 242, 236, 0.2);\n      }\n      .ritual-number { color: var(--rose); font-family: var(--serif); font-size: 2.5rem; line-height: 1; }\n      .ritual-note span:last-child {\n        color: var(--cream);\n        font-size: 0.76rem;\n        line-height: 1.6;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n      }\n\n      .offerings { background: var(--paper); }\n      .section-intro {\n        max-width: 39rem;\n        margin-bottom: 3.5rem;\n        color: var(--ink-soft);\n        font-size: 1.05rem;\n        line-height: 1.75;\n      }\n      .offer-grid { display: grid; gap: 0.85rem; }\n      .offer {\n        position: relative;\n        display: flex;\n        min-height: 30rem;\n        padding: clamp(1.6rem, 4vw, 2.6rem);\n        flex-direction: column;\n        isolation: isolate;\n        overflow: hidden;\n      }\n      .offer::before,\n      .offer::after {\n        position: absolute;\n        z-index: -1;\n        content: '';\n        pointer-events: none;\n      }\n      .offer::before {\n        right: -4rem;\n        bottom: -7rem;\n        width: 18rem;\n        height: 28rem;\n        border: 1px solid currentColor;\n        opacity: 0.18;\n        transform: rotate(28deg);\n      }\n      .offer::after {\n        right: 2.5rem;\n        bottom: 2.5rem;\n        width: 5rem;\n        height: 1px;\n        background: currentColor;\n        opacity: 0.28;\n      }\n      .offer--gift { color: var(--ink); background: var(--rose); }\n      .offer--seasonal { color: var(--paper); background: var(--sage); }\n      .offer--corporate { color: var(--ink); background: var(--greige); }\n      .offer-topline {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        gap: 1rem;\n        margin-bottom: auto;\n        padding-bottom: 3rem;\n        font-size: 0.64rem;\n        font-weight: 600;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n      }\n      .offer-index { font-family: var(--serif); font-size: 1.4rem; }\n      .offer h3 {\n        max-width: 10ch;\n        margin-bottom: 1rem;\n        font-family: var(--serif);\n        font-size: clamp(2.5rem, 5vw, 4.2rem);\n        font-weight: 400;\n        line-height: 0.95;\n      }\n      .offer p {\n        max-width: 34rem;\n        margin-bottom: 1.35rem;\n        color: currentColor;\n        line-height: 1.7;\n        opacity: 0.78;\n      }\n      .text-list {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 0.5rem 1.2rem;\n        margin: 0;\n        padding: 0;\n        list-style: none;\n      }\n      .text-list li {\n        position: relative;\n        padding-left: 0.9rem;\n        color: currentColor;\n        font-size: 0.78rem;\n        line-height: 1.5;\n      }\n      .text-list li::before {\n        position: absolute;\n        top: 0.55em;\n        left: 0;\n        width: 0.3rem;\n        height: 0.3rem;\n        content: '';\n        background: currentColor;\n        border-radius: 50%;\n      }\n      .offer-action {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        width: 100%;\n        min-height: 3.4rem;\n        margin-top: 2rem;\n        padding: 0.85rem 1rem;\n        font-size: 0.7rem;\n        font-weight: 600;\n        letter-spacing: 0.12em;\n        text-decoration: none;\n        text-transform: uppercase;\n        border: 1px solid currentColor;\n        transition: color 0.25s ease, background 0.25s ease;\n      }\n      .offer-action span:last-child { font-size: 1.1rem; }\n      .offer-action:hover { color: var(--ink); background: var(--paper); }\n\n      .events { position: relative; color: var(--paper); background: var(--ink); }\n      .events::before {\n        position: absolute;\n        top: 0;\n        right: 8%;\n        width: min(32vw, 22rem);\n        height: 1px;\n        content: '';\n        background: rgba(255, 252, 248, 0.5);\n        transform: rotate(52deg);\n        transform-origin: right;\n      }\n      .events .section-label, .events .section-intro { color: rgba(255, 252, 248, 0.76); }\n      .events-layout { display: grid; gap: 2.5rem; }\n      .event-list {\n        display: grid;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        margin: 0;\n        padding: 0;\n        list-style: none;\n        border-top: 1px solid rgba(255, 252, 248, 0.28);\n      }\n      .event-list li {\n        min-height: 6rem;\n        padding: 1.1rem 0.6rem 1.1rem 0;\n        font-family: var(--serif);\n        font-size: clamp(1.25rem, 3vw, 1.8rem);\n        line-height: 1.1;\n        border-bottom: 1px solid rgba(255, 252, 248, 0.28);\n      }\n      .event-list li:nth-child(odd) { padding-right: 1rem; border-right: 1px solid rgba(255, 252, 248, 0.28); }\n      .event-list li:nth-child(even) { padding-left: 1rem; }\n\n      .contact { text-align: center; background: var(--paper); }\n      .contact .display-heading { max-width: 13ch; margin-right: auto; margin-left: auto; }\n      .contact-copy {\n        max-width: 36rem;\n        margin: 0 auto 2rem;\n        color: var(--ink-soft);\n        line-height: 1.75;\n      }\n      .payment-details {\n        width: min(100%, 36rem);\n        margin: 0 auto 2rem;\n        padding: 1.5rem;\n        text-align: left;\n        background: rgba(228, 216, 203, 0.54);\n        border: 1px solid var(--line);\n      }\n      .payment-details h3 {\n        margin-bottom: 1.2rem;\n        font-family: var(--serif);\n        font-size: 2rem;\n        font-weight: 400;\n      }\n      .bank-details {\n        display: grid;\n        grid-template-columns: minmax(7rem, auto) 1fr;\n        gap: 0.65rem 1.25rem;\n        margin: 0;\n      }\n      .bank-details dt {\n        color: var(--ink-soft);\n        font-size: 0.72rem;\n        font-weight: 600;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n      }\n      .bank-details dd {\n        margin: 0;\n        font-size: 0.9rem;\n        font-weight: 600;\n      }\n      .payment-note {\n        margin: 1.25rem 0 0;\n        padding-top: 1rem;\n        color: var(--ink-soft);\n        font-size: 0.82rem;\n        line-height: 1.65;\n        border-top: 1px solid var(--line);\n      }\n      .contact .button-primary { color: var(--paper); background: var(--ink); }\n      .contact .button-secondary { color: var(--ink); border-color: var(--line); }\n      .contact .button-row { justify-content: center; }\n\n      .site-footer { color: var(--cream); background: var(--ink); }\n      .footer-inner {\n        display: grid;\n        gap: 2rem;\n        width: min(100% - 2rem, 76rem);\n        margin: 0 auto;\n        padding: 2.5rem 0;\n      }\n      .footer-brand { font-family: var(--serif); font-size: 2.2rem; }\n      .footer-details {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 0.65rem 1.4rem;\n        color: rgba(247, 242, 236, 0.68);\n        font-size: 0.76rem;\n        line-height: 1.6;\n      }\n      .footer-details a { text-decoration-color: rgba(247, 242, 236, 0.34); text-underline-offset: 0.25rem; }\n      .copyright { color: rgba(247, 242, 236, 0.48); font-size: 0.68rem; }\n\n      .reveal {\n        opacity: 0;\n        transform: translateY(1.5rem);\n        transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);\n      }\n      .reveal.is-visible { opacity: 1; transform: translateY(0); }\n      :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }\n\n      @media (min-width: 720px) {\n        .site-header, .hero-inner, .wrap, .footer-inner { width: min(100% - 4rem, 76rem); }\n        .nav-toggle { display: none; }\n        .site-nav {\n          position: static;\n          z-index: auto;\n          flex-direction: row;\n          gap: clamp(1rem, 2.5vw, 2rem);\n          color: var(--paper);\n          background: transparent;\n          opacity: 1;\n          pointer-events: auto;\n        }\n        .site-nav a {\n          font-family: var(--sans);\n          font-size: 0.66rem;\n          font-weight: 600;\n          letter-spacing: 0.12em;\n          text-transform: uppercase;\n        }\n        .welcome-layout {\n          grid-template-columns: minmax(0, 1.8fr) minmax(14rem, 0.8fr);\n          gap: clamp(3rem, 8vw, 8rem);\n        }\n        .hero-actions { grid-template-columns: auto 1fr; align-items: stretch; }\n        .hero-action-links { align-items: stretch; }\n        .offer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n        .offer--gift { min-height: 40rem; }\n        .offer--seasonal { min-height: 40rem; transform: translateY(3.5rem); }\n        .offer--corporate { grid-column: 1 / -1; min-height: 27rem; margin-top: 3.5rem; }\n        .offer--corporate h3 { max-width: none; }\n        .events-layout {\n          grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.2fr);\n          gap: clamp(3rem, 10vw, 9rem);\n        }\n        .footer-inner { grid-template-columns: auto 1fr auto; align-items: center; }\n        .footer-details { justify-content: center; }\n      }\n\n      @media (max-width: 719px) {\n        .hero-action-links,\n        .hero-actions .button { width: 100%; }\n        .hero-action-links .button { flex: 1 1 100%; }\n      }\n\n      @media (prefers-reduced-motion: reduce) {\n        html { scroll-behavior: auto; }\n        *, *::before, *::after {\n          animation-duration: 0.01ms !important;\n          transition-duration: 0.01ms !important;\n        }\n        .reveal { opacity: 1; transform: none; }\n      }\n</style>\n<section class=\"section\" id=\"welcome\" aria-labelledby=\"welcome-heading\">\n        <div class=\"wrap welcome-layout\">\n          <div class=\"reveal\">\n            <p class=\"section-label\">Welcome to Aura Spa</p>\n            <h2 class=\"display-heading\" id=\"welcome-heading\">Space to slow down, reconnect and simply breathe.</h2>\n            <div class=\"welcome-copy\">\n              <p>Designed with timeless elegance and inspired by the calming essence of nature, Aura Spa offers thoughtfully curated wellness experiences that restore balance, nurture confidence and awaken the senses.</p>\n              <p>Every experience is delivered with exceptional care in a tranquil environment that encourages you to slow down, reconnect and simply breathe.</p>\n              <p>Whether you’re visiting for an hour of self-care or a full day of indulgence, every detail has been carefully considered to leave you feeling refreshed, uplifted and already looking forward to your next visit.</p>\n            </div>\n          </div>\n          <aside class=\"welcome-aside reveal\" aria-label=\"Aura Spa location\">\n            <strong>Your quiet place.</strong>\n            <span>King’s Palace Hotel<br>Donkerhoek Road, Rustenburg</span>\n          </aside>\n        </div>\n      </section>"
              },
              "elements": [],
              "isInner": false,
