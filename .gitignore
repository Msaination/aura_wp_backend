# Keep WordPress core files required to run the site.
# The local wp-config.php is intentionally environment-specific and should stay out of Git.
# The core installation still remains tracked except for the local config file.

# Local environment files
.env
.env.*
wp-config-local.php
wp-config.php

# WordPress generated content and local-only data
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/blogs.dir/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/object-cache.php
wp-content/languages/*.mo
wp-content/languages/*.po
wp-content/ai1wm-backups/
wp-content/mu-plugins/

# Large archive backups and export files
*.wpress
*.zip
*.tar.gz

# Common local/editor artifacts
.DS_Store
Thumbs.db
*.log
*.sql
*.sqlite
*.tmp
*.bak
*.swp
.vscode/
.idea/

# Dependency directories that should not be versioned
vendor/
node_modules/

# Ignore theme/plugin build output if generated locally
wp-content/themes/*/node_modules/
wp-content/themes/*/.cache/
wp-content/plugins/*/node_modules/
wp-content/plugins/*/.cache/

# Ignore local backups but keep the clean project files tracked
wp-content/backups/
